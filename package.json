{
  "name": "@microtoll/pqc-scan",
  "version": "0.2.0",
  "description": "An inventory of the cryptography a JavaScript or TypeScript codebase uses, and which of it a large quantum computer would break. An inventory and pointers, not a compliance certificate.",
  "keywords": [
    "post-quantum",
    "pqc",
    "cryptography",
    "inventory",
    "ncsc",
    "security",
    "static-analysis",
    "cli",
    "github-action",
    "zero-dependencies"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microtoll/pqc-scan.git"
  },
  "homepage": "https://github.com/microtoll/pqc-scan#readme",
  "bugs": {
    "url": "https://github.com/microtoll/pqc-scan/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "pqc-scan": "bin/pqc-scan.mjs"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "action.yml",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/package.test.mjs test/tokenize.test.mjs test/detect.test.mjs test/report.test.mjs test/cbom.test.mjs test/cli.test.mjs"
  },
  "dependencies": {}
}
